{
  "name": "dashboard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build:packages": "bun run --filter=@repo/types build && bun run --filter=@repo/db build && bun run --filter=@repo/redis build",
    "dev": "next dev --port 3000",
    "build": "bun run build:packages && next build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/db": "*",
    "@repo/redis": "*",
    "@repo/types": "*",
    "bcryptjs": "^3.0.2",
    "ioredis": "^5.11.1",
    "jose": "^5.10.0",
    "next": "15.5.26",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.6",
    "typescript": "^5.5.4"
  }
}
